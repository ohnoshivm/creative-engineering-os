{
  "name": "ceos-motion-heavy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "test": "playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:update-snapshots": "playwright test --grep @visual --update-snapshots",
    "lhci": "npx --yes @lhci/cli@0.15.1 autorun",
    "audit:visual": "node ../../tooling/visual-audit/capture.mjs --url http://localhost:4174 --out docs/QA/latest"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.27"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
